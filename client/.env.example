# Optional overrides for client/.env.development (or .env.local, which is gitignored).
#
# When VITE_API_URL is unset, the app defaults to "/api/v1", which is served
# by the Vite dev proxy in development and by the Vercel /api rewrite in prod.
# Only set this to a full origin if you want to bypass the proxy/rewrite.
VITE_API_URL=

# Vite dev proxy target. Leave blank to auto-detect PORT from server/.env.
VITE_DEV_PROXY_TARGET=
